# Windows offline delivery bundle (F1.2-D): the three core files the operator
# downloads once (a 2.4 GB wheel cannot live in this repository) and the offline
# cache prepare_offline_bundle.ps1 builds from them. Both are local build inputs
# for windows\build_zip.ps1 and never committed; the delivery scripts, the
# manifest and the locks stay tracked.
/依赖/
/offline_cache/
/windows/offline/

# Controlled weight library (F1.1-A): operator-supplied .pt files only.
# Binary weights are never committed; the directory itself is not tracked.
models/weights/

# Config with secrets
auto_tune/config.yaml
!auto_tune/config.template.yaml

